<Application x:Class="QzLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- 全局样式：玻璃拟态 + 蓝色渐变主题 -->
        <SolidColorBrush x:Key="BgBrush" Color="#0F1220"/>
        <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#00C853" Offset="0"/>
            <GradientStop Color="#00E676" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="CardBrush" Color="#1A1E2E"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E6EAF2"/>
        <SolidColorBrush x:Key="SubTextBrush" Color="#8B93A7"/>
    </Application.Resources>
</Application>
